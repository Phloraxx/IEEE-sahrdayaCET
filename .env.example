# Deployment identity. Never point staging/dev at production PocketBase data.
DEPLOY_ENV=staging
SITE_URL=https://staging.ieeesahrdaya.com

# Generate a different high-entropy 32-character value for every environment.
PB_ENCRYPTION_KEY=

# Internal capability shared only by the web and PocketBase containers.
# Generate a separate high-entropy value (32+ chars) for every environment.
CERTIFICATE_RENDER_CAPABILITY_KEY=

# Direct Razorpay integration. These values are PocketBase-only secrets except
# the Key ID, which is returned to Standard Checkout as the public key.
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_HOLD_SECONDS=600
# Emergency switch: false blocks new paid registrations/orders, while webhook
# reconciliation and refunds continue to run.
PAYMENTS_ENABLED=true

# Other optional backend integrations.
FOOTBALL_DATA_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional PocketBase SMTP tuning. Leave blank for sensible defaults.
SMTP_TLS=
SMTP_AUTH_METHOD=
SMTP_LOCAL_NAME=

# Mail safety. Every environment fails closed when MAIL_DELIVERY_MODE is blank.
# Recommended staging mode: disabled or a tightly controlled allowlist.
# Production deployment mode is disabled; live delivery requires a separate explicit opt-in.
MAIL_DELIVERY_MODE=disabled
MAIL_ALLOWLIST=
MAIL_REDIRECT_TO=

# Certificate mail transport. SMTP remains the backwards-compatible default.
# `resend` adds provider delivery/bounce/complaint observability.
CERTIFICATE_MAIL_PROVIDER=smtp
RESEND_API_BASE_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Internal web → PocketBase bridge used only after public webhook verification.
CERTIFICATE_MAIL_WEBHOOK_CAPABILITY_KEY=

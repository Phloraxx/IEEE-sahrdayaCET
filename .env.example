# Deployment identity. Never point staging/dev at production PocketBase data.
DEPLOY_ENV=staging
SITE_URL=https://dev.ieeesahrdaya.com

# Generate a different high-entropy 32-character value for every environment.
PB_ENCRYPTION_KEY=

# Backend-only secrets. Leave optional integrations blank when unused.
PAYMENT_WEBHOOK_SECRET=
FOOTBALL_DATA_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

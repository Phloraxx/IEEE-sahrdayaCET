# Deployment identity. Never point staging/dev at production PocketBase data.
DEPLOY_ENV=staging
SITE_URL=https://staging.ieeesahrdaya.com

# Generate a different high-entropy 32-character value for every environment.
PB_ENCRYPTION_KEY=

# PayGate direct-UPI integration. These values are backend-only and belong on
# the PocketBase service, never in the React/browser environment.
# Staging/dev must use a non-production PayGate target and credentials.
PAYGATE_URL=
PAYGATE_API_KEY=
PAYGATE_WEBHOOK_SECRET=
PAYGATE_REGISTRATION_GRACE_SECONDS=600
PAYGATE_WEBHOOK_TOLERANCE_SECONDS=300

# Legacy payment-confirm callback secret retained during migration. Do not reuse
# it as the PayGate HMAC webhook secret.
PAYMENT_WEBHOOK_SECRET=

# Other optional backend integrations.
FOOTBALL_DATA_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Deployment identity. Never point staging/dev at production PocketBase data.
DEPLOY_ENV=staging
SITE_URL=https://staging.ieeesahrdaya.com

# Generate a different high-entropy 32-character value for every environment.
PB_ENCRYPTION_KEY=

# Internal capability shared only by the web and PocketBase containers.
# Generate a separate high-entropy value (32+ chars) for every environment.
CERTIFICATE_RENDER_CAPABILITY_KEY=

# PayGate v4 payment integration. Configure separately per environment.
# PAYGATE_CLIENT_NAMESPACE is optional; SITE_URL derives staging/production by default.
PAYGATE_URL=
PAYGATE_API_KEY=
PAYGATE_WEBHOOK_SECRET=
PAYGATE_REGISTRATION_GRACE_SECONDS=600
PAYGATE_WEBHOOK_TOLERANCE_SECONDS=300
PAYGATE_CLIENT_NAMESPACE=

# Other optional backend integrations.
FOOTBALL_DATA_API_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# PocketBase SMTP_TLS=true means implicit TLS (normally port 465). Gmail port 587
# uses STARTTLS negotiation, so keep this false.
SMTP_TLS=false
SMTP_AUTH_METHOD=
SMTP_LOCAL_NAME=

# Mail safety. Every environment fails closed when MAIL_DELIVERY_MODE is blank.
# Recommended staging mode: disabled or a tightly controlled allowlist.
# Production deployment mode is disabled; live delivery requires a separate explicit opt-in.
MAIL_DELIVERY_MODE=disabled
MAIL_ALLOWLIST=
MAIL_REDIRECT_TO=

# Gmail SMTP transport. Keep MAIL_DELIVERY_MODE=disabled until credentials are
# configured and a controlled acceptance test is explicitly authorized.
# Gmail/Google Workspace submission: smtp.gmail.com:587 with STARTTLS.
# Use the full Gmail address as SMTP_USERNAME and a Google App Password as SMTP_PASSWORD.
# Never commit the App Password.

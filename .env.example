# Deployment identity. Never point staging/dev at production PocketBase data.
DEPLOY_ENV=staging
SITE_URL=https://staging.ieeesahrdaya.com

# --- Compose / host-side -----------------------------------------------------
# Consumed by docker-compose.yml, not by the app. Every value is required: the
# deploy fails fast rather than routing the wrong host or mounting the wrong
# directory.
#
# Traefik router key, unique per environment (letters, digits and dashes):
#   staging:    ieee-staging-web
#   production: ieee-production-web
ROUTER_KEY=
# Public hostname the router matches, without a scheme:
#   staging:    staging.ieeesahrdaya.com
#   production: ieeesahrdaya.com
SITE_HOST=
# Host directory mounted at /app/data. Holds portal.db (SQLITE_PATH) and uploads/.
# Must be writable by uid 1000 (the image's `node` user).
SQLITE_DATA_DIR=
# Host directory mounted at /app/data/uploads.
UPLOADS_HOST_DIR=

# Comma-separated origins allowed to call the API. The site origin is enough.
ALLOWED_ORIGINS=
# __Host- prefix requires HTTPS and no Domain attribute. Leave the default.
SESSION_COOKIE_NAME=__Host-ieee_session

# Generate a different high-entropy 32-character value for every environment.
PB_ENCRYPTION_KEY=

# Internal capability shared only by the web and PocketBase containers.
# Generate a separate high-entropy value (32+ chars) for every environment.
CERTIFICATE_RENDER_CAPABILITY_KEY=

# PayGate v4 payment integration. Configure separately per environment.
# PAYGATE_CLIENT_NAMESPACE is optional; SITE_URL derives staging/production by default.
PAYGATE_URL=
PAYGATE_API_KEY=
PAYGATE_WEBHOOK_SECRET=
PAYGATE_REGISTRATION_GRACE_SECONDS=600
# Runtime caps callback freshness at 900 seconds.
PAYGATE_WEBHOOK_TOLERANCE_SECONDS=300
PAYGATE_CLIENT_NAMESPACE=

# Other optional backend integrations.
FOOTBALL_DATA_API_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# PocketBase SMTP_TLS=true means implicit TLS (normally port 465). Gmail port 587
# uses STARTTLS negotiation, so keep this false.
SMTP_TLS=false
SMTP_AUTH_METHOD=
SMTP_LOCAL_NAME=

# Mail safety. Every environment fails closed when MAIL_DELIVERY_MODE is blank.
# Recommended staging mode: disabled or a tightly controlled allowlist.
# Production deployment mode is disabled; live delivery requires a separate explicit opt-in.
MAIL_DELIVERY_MODE=disabled
MAIL_ALLOWLIST=
MAIL_REDIRECT_TO=

# --- In-process jobs ---------------------------------------------------------
# The web process runs the job runner: notification outbox, payment expiry,
# session pruning and a daily backup. On in production; set 0 to stop it.
JOBS_ENABLED=
# Host directory mounted at /app/backups. Must be writable by uid 1000 (the
# image's `node` user). Archives are prefixed with the environment name.
BACKUP_HOST_DIR=/home/drvij/ieee-backups/app
# Daily archives kept per environment.
BACKUP_KEEP=14
# Rolling 24-hour send cap per account. Google Workspace allows 2,000.
MAIL_DAILY_LIMIT=1500

# Gmail SMTP transport. Keep MAIL_DELIVERY_MODE=disabled until credentials are
# configured and a controlled acceptance test is explicitly authorized.
# Gmail/Google Workspace submission: smtp.gmail.com:587 with STARTTLS.
# Use the full Gmail address as SMTP_USERNAME and a Google App Password as SMTP_PASSWORD.
# Never commit the App Password.

# --- SQLite port (phase 0) ---------------------------------------------------
# Path to the SQLite database. The parent directory is created on first use.
SQLITE_PATH=./data/portal.db
# Root of the uploads volume. Files live here, never in the database.
UPLOADS_DIR=./data/uploads
# HMAC key for signing the OAuth state cookie. At least 32 bytes.
# Generate with: openssl rand -base64 48
APP_SECRET=
# Google OAuth. Same client PocketBase uses. The secret is server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL; the OAuth redirect URI is ${APP_URL}/auth/google/callback
APP_URL=http://localhost:5173
# Session lifetime in days (sliding).
SESSION_TTL_DAYS=30

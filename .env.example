# Copy this file to .env.local and fill in the values.

# Google OAuth — only used by `bun run migrate:pb` to configure PB OAuth, not at runtime.
# Fill these in from Google Cloud Console → https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment gateway
PAYMENT_WEBHOOK_SECRET=

# Internal API secret — shared between app server and PB hooks for coupon validation proxy.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=

# Public app URL (used for OAuth redirects, CSRF origin check)
PUBLIC_APP_URL=http://localhost:3001

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
# NOTE: Do NOT create a VITE_POCKETBASE_URL. The PB URL must stay server-side;
# route loaders fetch via createServerFn (see src/routes/full-execom.tsx).

# Superuser token — used ONLY by migration scripts (migrate-to-pb.ts,
# migrate-indexes.ts, migrate-pb-rules.ts). NOT used at runtime.
POCKETBASE_SUPERUSER_TOKEN=

# CSRF protection for OAuth state cookie — any random string works locally
OAUTH_COOKIE_SECRET=
